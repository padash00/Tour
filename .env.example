# Supabase → Project Settings → API
SUPABASE_URL=https://dgpxlpjnjthyotjcccfl.supabase.co
# secret / service_role ключ. Только на сервере, никогда не публиковать.
SUPABASE_SERVICE_ROLE_KEY=

# Только для ручного запуска db:migrate / db:check; не нужны браузеру.
SUPABASE_PROJECT_REF=dgpxlpjnjthyotjcccfl
SUPABASE_ACCESS_TOKEN=

# Длинная случайная строка для подписи cookie сессии (например: openssl rand -base64 48)
SESSION_SECRET=

# https://steamcommunity.com/dev/apikey — без ключа ник/аватар берутся из публичного профиля
STEAM_API_KEY=

# https://developers.faceit.com — Server side API key. Без ключа FACEIT просто не подтягивается
FACEIT_API_KEY=

# SteamID64 администраторов через запятую
ADMIN_STEAM_IDS=
